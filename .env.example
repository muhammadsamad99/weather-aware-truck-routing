# Environment variables the app reads (it does not load a .env file: export them, or set them on the host).

# Local development: debug on, and a throwaway secret key is used.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is not 1.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# On Render, RENDER_EXTERNAL_HOSTNAME is set by the platform and added to the allowed hosts automatically.

# Routing provider. "valhalla" is the one implemented; see the README for adding another.
ROUTING_PROVIDER=valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de
# Seconds between requests to the routing server; the public one allows one per second. 0 for your own.
VALHALLA_MIN_INTERVAL_SECONDS=1.0
# The backup when Valhalla fails: car routes (OSRM has no truck profile). The demo server allows one request per second.
OSRM_URL=https://router.project-osrm.org
OSRM_MIN_INTERVAL_SECONDS=1.0

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# The backup when Open-Meteo fails. Its terms allow at most 20 requests a second.
MET_NORWAY_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
MET_NORWAY_MIN_INTERVAL_SECONDS=0.1
PHOTON_URL=https://photon.komoot.io/api/
# The backup for a plan's place lookups when Photon fails. Its policy allows one request per second.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# The backup for place suggestions when Photon fails (towns, cities and postcodes).
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
